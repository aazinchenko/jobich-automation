<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Jobich QA Automation Suite" parallel="classes" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="ch.jobich.automation.listeners.TestListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Parallel Run Check">
        <classes>
            <class name="ch.jobich.automation.FirstBrowserTest"/>
        </classes>
    </test>

    <test name="All">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="ch.jobich.automation"/>
        </packages>
    </test>

    <test name="Cucumber BDD">
        <classes>
            <class name="ch.jobich.automation.bdd.runners.CucumberTestNgRunner"/>
        </classes>
    </test>

</suite>